# Example .env configuration
# Copy this to .env and customize for your setup

IRC_SERVER=irc.example.com
IRC_PORT=6697
BOT_NICKNAME=MansionRadio
IRC_CHANNELS=#radio

# SASL Authentication (for registered nicks on restricted servers)
# SASL_USERNAME is optional - defaults to BOT_NICKNAME if not provided
SASL_USERNAME=your_account_name
SASL_PASSWORD=your_sasl_password

AZURACAST_API=https://radio.example.com/api/nowplaying/station_id

POLL_INTERVAL=60

# Logging (optional, defaults to INFO)
# Set to DEBUG for verbose polling output
# LOG_LEVEL=INFO
